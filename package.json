{
  "name": "@marcalexiei/prettier-config",
  "description": "Custom prettier config",
  "version": "2.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20"
  },
  "keywords": [
    "format",
    "prettier",
    "prettier-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/prettier-config"
  },
  "author": "Marco Pasqualetti @marcalexiei",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.cjs",
    "default": "./dist/index.js"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test ./*.spec.js",
    "release": "pnpm run build && changeset publish"
  },
  "peerDependencies": {
    "prettier": "^2.8.0 || ^3.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "prettier": "3.8.3",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.25.0",
    "typescript": "6.0.3"
  }
}
