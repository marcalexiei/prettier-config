{
  "name": "@marcalexiei/prettier-config",
  "description": "Custom prettier config",
  "version": "1.1.4",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20"
  },
  "keywords": [
    "format",
    "prettier",
    "prettier-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/prettier-config"
  },
  "author": "Marco Pasqualetti @marcalexiei",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.cjs",
    "default": "./dist/index.js"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "node --test ./*.spec.js",
    "release": "pnpm run build && changeset publish"
  },
  "peerDependencies": {
    "prettier": "^2.8.0 || ^3.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@types/node": "24.10.1",
    "prettier": "3.7.3",
    "rolldown": "1.0.0-beta.52",
    "rolldown-plugin-dts": "0.18.1",
    "typescript": "5.9.3"
  }
}
